# Copy to .env and fill in. .env is never committed (.gitignore) and never copied into the image
# (.dockerignore). deploy/push.sh copies it to the server, over ssh.
OPENAI_API_KEY=

# Optional. Another OpenAI model:
#   PORTER_MODEL=gpt-4.1
# Or Ollama on this machine instead of OpenAI (no key needed):
#   PORTER_PROVIDER=ollama
#   PORTER_BASE_URL=http://host.docker.internal:11434/v1    # only when Porter runs in a container
