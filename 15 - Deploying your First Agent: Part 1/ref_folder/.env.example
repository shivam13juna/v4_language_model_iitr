# Copy to .env and fill in. .env is never committed and never copied into an image
# (.gitignore, .dockerignore). Every variable is a field in porter/settings.py.

# --- who may call it -----------------------------------------------------------------
# Signs and checks bearer tokens. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTER_AUTH_SECRET=
# On a laptop only: lets the web page sign in as any customer. Never true on a deployment.
PORTER_DEV_LOGIN=true

# --- the model -------------------------------------------------------------------------
# PORTER_PROVIDER picks where the model runs. Both providers serve OpenAI's Chat Completions
# API, so the service is the same code for either; switching is this one line.
#   openai   gpt-4.1-mini on OpenAI's API (the default). Needs OPENAI_API_KEY, which is
#            billed for every request.
#   ollama   gpt-oss:20b in Ollama on this machine (ollama pull gpt-oss:20b). No key.
PORTER_PROVIDER=openai
OPENAI_API_KEY=

# A different model from the same provider (optional):
#   PORTER_MODEL=gpt-4.1
# Ollama on another machine, through its ngrok tunnel (ngrok/README.md), for anyone who
# cannot run the model themselves:
#   PORTER_PROVIDER=ollama
#   PORTER_BASE_URL=https://<your-static-domain>.ngrok-free.app/v1
#   PORTER_API_KEY=<PORTER_MODEL_TOKEN, the token the tunnel checks>

# --- the tunnel itself (read by ngrok/start_model_tunnel.sh, not by the service) -------
# Only on the machine that serves its Ollama to others.
PORTER_MODEL_TOKEN=
NGROK_DOMAIN=
